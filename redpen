  // A selector stable enough for an agent to find the node again. id wins; then
  // a short nth-of-type path. Not bulletproof on a page that rerenders, which is
  // why the element's own HTML is sent too.
  function selectorFor(el) {
    if (!el || el.nodeType !== 1) return null;
    if (el.id) return '#' + el.id;
    var parts = [];
    while (el && el.nodeType === 1 && parts.length < 6) {
      var part = el.tagName.toLowerCase();
      if (el.id) { parts.unshift('#' + el.id); break; }
      var p = el.parentElement;
      if (p) {
        var sibs = Array.prototype.filter.call(p.children, function (c) { return c.tagName === el.tagName; });
        if (sibs.length > 1) part += ':nth-of-type(' + (sibs.indexOf(el) + 1) + ')';
      }
      parts.unshift(part);
      el = el.parentElement;
      if (el === document.body) { parts.unshift('body'); break; }
    }
    return parts.join(' > ');
  }

  function isOurs(el) {
    // The overlay's own nodes must never be reported as page content: the lasso
    // box exactly covers the region the user drew, so without this it always
    // wins the outermost-element test and the agent gets __ann-box back.
    return !!(el.closest && el.closest(
      '.__ann-box, .__ann-modal, .__ann-hint, .__ann-toast, ' +
      '.__ann-drawer, .__ann-tab, .__ann-pin, .__ann-refresh'));
  }

  function elementsIn(rect) {
    var out = [], all = document.body.querySelectorAll('*');
    for (var i = 0; i < all.length; i++) {
      if (isOurs(all[i])) continue;
      var r = all[i].getBoundingClientRect();
      if (!r.width || !r.height) continue;
      if (r.left >= rect.left - 2 && r.top >= rect.top - 2 &&
          r.right <= rect.right + 2 && r.bottom <= rect.bottom + 2) {
        // Keep only the outermost: a container already covers its children.
        if (!out.some(function (o) { return o.contains(all[i]); })) out.push(all[i]);
      }
    }
    return out.slice(0, 8);
  }

  function closeModal() {
    if (modal) { modal.remove(); modal = null; }
    if (box) { box.remove(); box = null; }
    pending = null;
  }

  function toast(msg, ok) {
    var t = document.createElement('div');
    t.className = '__ann-toast';
    t.textContent = msg;
    if (!ok) t.style.background = '#a00';
    document.body.appendChild(t);
    setTimeout(function () { t.remove(); }, 2600);
  }

  function openModal(x, y, context) {
    closeModalKeepBox();
    pending = context;
    modal = document.createElement('div');
    modal.className = '__ann-modal';
    modal.style.left = Math.min(x, window.innerWidth - 340) + 'px';
    modal.style.top = Math.min(y, window.innerHeight - 190) + 'px';
    var ctx = (context.selected_text || context.element_text || '').slice(0, 160);
    modal.innerHTML =
      '<div class="__ann-ctx">' + (ctx ? '“' + ctx.replace(/</g, '&lt;') + '”' : context.selector || '') + '</div>' +
      '<textarea placeholder="comment…   enter saves   \u2325 enter processes"></textarea>' +
      '<div style="margin-top:8px;display:flex;gap:8px;justify-content:flex-end">' +
      '<button class="__ann-cancel">cancel</button>' +
      '<button class="__ann-set" title="save it and keep reading (enter)">save</button>' +
      '<button class="__ann-send" title="save and process it now (\u2325 enter)">process</button></div>';
    document.body.appendChild(modal);
    var ta = modal.querySelector('textarea');
    ta.focus();
    modal.querySelector('.__ann-cancel').onclick = closeModal;
    modal.querySelector('.__ann-set').onclick = function () { submit(ta.value, false); };
    modal.querySelector('.__ann-send').onclick = function () { submit(ta.value, true); };
    ta.addEventListener('keydown', function (e) {
      // One modifier for the whole tool: OPTION. Option-click opens a
      // comment, option-enter processes it. Enter alone saves, because that is
      // the common case. Shift-enter is a newline. Cmd-enter is kept as an
      // alias only because it is muscle memory from everywhere else.
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        submit(ta.value, e.altKey || e.metaKey || e.ctrlKey);
      }
      if (e.key === 'Escape') closeModal();
    });
  }
  function closeModalKeepBox() { if (modal) { modal.remove(); modal = null; } }

  function submit(text, send) {
    if (!text || !text.trim()) { toast('empty comment, not sent', false); return; }
    var payload = Object.assign({}, pending, {
      send: !!send,
      comment: text.trim(),
      url: location.href,
      title: document.title,
      viewport: { w: window.innerWidth, h: window.innerHeight },
      scroll: { x: window.scrollX, y: window.scrollY },
      at: new Date().toISOString()
    });
    fetch(ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    }).then(function (r) {
      if (!r.ok) { toast('save failed: ' + r.status, false); return; }
      return r.json().then(function (d) {
        if (!send) { toast('saved', true); }
        else { toast(describe(d), d.delivered || !!d.queued); }
        loadDrawer();
      });
    }).catch(function (e) { toast('save failed: ' + e.message, false); });
    closeModal();
  }

  // ---- pins on the page ------------------------------------------------
  // Anchored by SELECTOR first, because the page may have re-rendered since
  // the comment was left and the saved rect would then point at empty space.
  // The rect is the fallback, converted back to page coordinates using the
  // scroll position recorded at the time.
  function placePins(items) {
    Array.prototype.forEach.call(document.querySelectorAll('.__ann-pin'),
      function (p) { p.remove(); });
    items.forEach(function (a, i) {
      var x = null, y = null, el = null;
      if (a.selector) { try { el = document.querySelector(a.selector); } catch (e) {} }
      if (el) {
        var r = el.getBoundingClientRect();
        if (r.width || r.height) { x = r.left + window.scrollX; y = r.top + window.scrollY; }
      }
      if (x === null && a.rect) {
        x = (a.rect.x || 0) + ((a.scroll && a.scroll.x) || 0);
        y = (a.rect.y || 0) + ((a.scroll && a.scroll.y) || 0);
      }
      if (x === null) return;                       // nothing to anchor to
      var pin = document.createElement('div');
      pin.className = '__ann-pin' + (a.done ? ' __done' : '');
      pin.innerHTML =
        '<svg viewBox="0 0 24 24" aria-hidden="true">' +
        '<path d="M15.6 3.6l4.8 4.8-10.2 10.2-6 1.2 1.2-6z"/></svg>' +
        '<b>' + (i + 1) + '</b>';
      pin.style.left = Math.max(2, x) + 'px';
      pin.style.top = Math.max(24, y) + 'px';
      pin.title = (a.done ? 'done: ' : '') + (a.comment || '');
      pin.onclick = function (ev) {
        ev.stopPropagation();                       // never advance a deck
        ensureDrawer();
        drawer.classList.add('__ann-open');
        // Match by file, not by index: the drawer is grouped by page, so its
        // order no longer lines up with the pins.
        var cb = drawer.querySelector('.__ann-pick[data-file="' + a.file + '"]');
        var row = cb ? cb.parentElement : null;
        if (row) {
          row.scrollIntoView({ block: 'center' });
          row.style.background = '#fffbdd';
          setTimeout(function () { row.style.background = ''; }, 1200);
        }
      };
      document.body.appendChild(pin);
    });
  }

  // ---- comment drawer --------------------------------------------------
  // Pending vs done is read straight off the filesystem: the agent moves a
  // file into .annotations/done/ when it has acted on it, which is the
  // convention already in use. No status protocol to keep in sync.
  var drawer = null, tab = null;
  var prefs = { group: 'page', showDone: false };
  try { Object.assign(prefs, JSON.parse(localStorage.getItem('__ann_prefs') || '{}')); } catch (e) {}
  function savePrefs() {
    try { localStorage.setItem('__ann_prefs', JSON.stringify(prefs)); } catch (e) {}
  }

  function ensureDrawer() {
    if (drawer) return;
    tab = document.createElement('button');
    tab.className = '__ann-tab';
    tab.textContent = 'comments';
    tab.onclick = function () {
      drawer.classList.toggle('__ann-open');
      if (drawer.classList.contains('__ann-open')) loadDrawer();
    };
    document.body.appendChild(tab);

    drawer = document.createElement('div');
    drawer.className = '__ann-drawer';
    drawer.innerHTML =
      '<h4>Comments <span class="__ann-count"></span>' +
      '<button class="__ann-close" title="close">×</button></h4>' +
      '<div class="__ann-to">goes to <b class="__ann-agent">…</b>' +
      '<span class="__ann-age"></span></div>' +
      '<div class="__ann-stale" hidden>This server is running older code than ' +
      'what is installed. Restart it or you are commenting on a stale build.</div>' +
      '<div class="__ann-opts">' +
      '<select class="__ann-group"><option value="page">by page</option>' +
      '<option value="recent">most recent</option></select>' +
      '<label><input type="checkbox" class="__ann-showdone"> show processed</label>' +
      '<label title="plain left-click adds a comment, no option key needed">' +
      '<input type="checkbox" class="__ann-clickmode"> click to comment</label>' +
      '</div>' +
      '<div class="__ann-list"></div>' +
      '<div class="__ann-bar">' +
      '<label><input type="checkbox" class="__ann-all" checked> all</label>' +
      '<button class="__ann-send-sel">process</button></div>' +
      '<div class="__ann-brand">' +
      '<svg viewBox="0 0 24 24" aria-hidden="true">' +
      '<path d="M15.6 3.6l4.8 4.8-10.2 10.2-6 1.2 1.2-6z"/>' +
      '<path d="M14.1 5.1l4.8 4.8" class="__nib"/></svg>' +
      '<span>redpen</span><em class="__ann-ver"></em></div>';
    document.body.appendChild(drawer);
    drawer.querySelector('.__ann-close').onclick = function () {
      drawer.classList.remove('__ann-open');
    };
    var g = drawer.querySelector('.__ann-group');
    g.value = prefs.group;
    g.onchange = function (e) { prefs.group = e.target.value; savePrefs(); loadDrawer(); };
    var cm = drawer.querySelector('.__ann-clickmode');
    cm.onchange = function (e) {
      commentMode = e.target.checked;
      document.documentElement.style.cursor = commentMode ? 'crosshair' : '';
    };
    var sd = drawer.querySelector('.__ann-showdone');
    sd.checked = prefs.showDone;
    sd.onchange = function (e) { prefs.showDone = e.target.checked; savePrefs(); loadDrawer(); };
    drawer.querySelector('.__ann-all').onchange = function (e) {
      Array.prototype.forEach.call(drawer.querySelectorAll('.__ann-pick'),
        function (c) { c.checked = e.target.checked; });
      updateBar();
    };
    drawer.querySelector('.__ann-send-sel').onclick = function () {
      var files = Array.prototype.filter.call(drawer.querySelectorAll('.__ann-pick'),
        function (c) { return c.checked; }).map(function (c) { return c.dataset.file; });
      if (!files.length) { toast('nothing selected', false); return; }
      processFiles(files);
    };

  }

  // Module scope, not inside ensureDrawer: loadDrawer calls it, and a
  // ReferenceError there is swallowed by the fetch .catch, so the rows simply
  // never render and nothing says why.
  function updateBar() {
    if (!drawer) return;
    var n = drawer.querySelectorAll('.__ann-pick:checked').length;
    var b = drawer.querySelector('.__ann-send-sel');
    if (!b) return;
    var open = drawer.querySelectorAll('.__ann-pick').length;
    b.textContent = n ? ('process ' + n) : 'process';
    b.disabled = !n || !open;
    drawer.querySelector('.__ann-all').disabled = !open;
  }

  // One place decides what a send outcome reads like. Queued is a normal
  // state, not an error: the agent is busy and it will go when it is free.
  function describe(d) {
    var who = d.agent || 'the agent';
    if (d.delivered) return 'processing ' + (d.count || 1) + ' with ' + who;
    if (d.queued) return 'queued for ' + who + ' (' + d.queued +
      (d.queued === 1 ? ' waiting)' : ' waiting)') + ', it is busy';
    return 'could not reach ' + who + ': ' + (d.why || 'unknown');
  }

  function processFiles(files) {
    return fetch(ENDPOINT + '?action=send', { method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ files: files }) })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        toast(describe(d), d.delivered || !!d.queued);
        loadDrawer();
      });
  }

  // Poll for work coming back. NEVER reload on its own: a reload would throw
  // away a comment half typed in the modal. Say so and let him choose.
  var lastDone = null, banner = null;
  function noticeProcessed(d) {
    var n = (d.done || []).length;
    if (lastDone !== null && n > lastDone) showRefresh(n - lastDone);
    lastDone = n;
  }
  function showRefresh(k) {
    if (!banner) {
      banner = document.createElement('div');
      banner.className = '__ann-refresh';
      banner.innerHTML = '<span></span><button>refresh</button>';
      banner.querySelector('button').onclick = function () { location.reload(); };
      document.body.appendChild(banner);
    }
    banner.querySelector('span').textContent =
      k + (k === 1 ? ' comment processed.' : ' comments processed.') +
      ' The page may have been rebuilt.';
    banner.classList.add('__ann-show');
  }
  setInterval(function () {
    fetch(ENDPOINT + '?action=list').then(function (r) { return r.json(); })
      .then(function (d) {
        noticeProcessed(d);
        // Only redraw the drawer when nothing is being typed into it.
        if (!modal) { try { renderDrawer(d); } catch (e) {} }
      }).catch(function () {});
