class Handler(http.server.SimpleHTTPRequestHandler):
    root = None
    outdir = None
    served_dir = None
    on_send = None      # command run when he presses send
    target_name = None  # who that reaches, shown in the drawer
    proxy = None   # when set, serve someone else's app and inject into its HTML

    def log_message(self, fmt, *args):  # quieter than the default
        # args[0] is not always a string: log_error passes an HTTPStatus.
        first = str(args[0]) if args else ""
        if "__annotate" in first:
            sys.stderr.write("  %s\n" % (fmt % args))

    def _annotations(self):
        """Pending and done, newest first. Done is simply the done/ subfolder,
        which is where an agent moves a file once it has acted on it."""
        def read(d, done):
            out = []
            if not d.is_dir():
                return out
            for f in sorted(d.glob("*.json"), reverse=True):
                try:
                    rec = json.loads(f.read_text())
                except Exception:
                    continue
                rec["file"] = f.name
                rec["done"] = done
                out.append(rec)
            return out
        return read(self.outdir, False), read(self.outdir / "done", True)

    def _json(self, obj, code=200):
        raw = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def do_POST(self):
        # "send all": wake the agent for everything still pending.
        if self.path.startswith("/__annotate?action=send"):
            try:
                n = int(self.headers.get("Content-Length", 0))
                body = json.loads(self.rfile.read(n) or b"{}")
            except Exception:
                body = {}
            pending, _ = self._annotations()
            # A subset if the drawer named files, otherwise everything open.
            want = set(body.get("files") or [])
            chosen = [a for a in pending if a["file"] in want] if want else pending
            names = [a["file"] for a in chosen]
            ok, why, who = (_deliver(self.served_dir, self.outdir, len(chosen),
                                     names, self.on_send)
                            if chosen else (False, "nothing selected", None))
            queued = 0
            if ok is None:                      # not now: stack them up
                queued = _queue_add(names)
                ok = False
            elif ok:
                _queue_clear(names)
            return self._json({"delivered": ok, "queued": queued, "why": why,
                               "count": len(chosen),
                               "agent": who or self.target_name})
        if self.path != "/__annotate":
            self.send_error(404)
            return
        try:
            n = int(self.headers.get("Content-Length", 0))
            data = json.loads(self.rfile.read(n) or b"{}")
        except Exception as e:
            self.send_error(400, str(e))
            return

        self.outdir.mkdir(parents=True, exist_ok=True)
        stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S")
        # A slug from the comment makes the directory readable at a glance.
        slug = re.sub(r"[^a-z0-9]+", "-", data.get("comment", "")[:40].lower()).strip("-") or "note"
        path = self.outdir / f"{stamp}-{slug}.json"
        i = 2
        while path.exists():
            path = self.outdir / f"{stamp}-{slug}-{i}.json"
            i += 1
        # Stamp who this belongs to AT SAVE TIME. Ownership computed only at
        # send time is lost the moment a push fails, and a comment with no
        # recorded owner cannot be found by the agent that should action it.
        # The push below is then best effort: failing it costs latency, not
        # the comment.
        if self.target_name and not data.get("agent"):
            data["agent"] = self.target_name

        # And WHICH FILE the comment is about, as a path on disk. The record
        # carries the page URL, but an agent should not have to map
        # "/deck.html" back to somewhere on the filesystem, and getting that
        # wrong means editing the wrong copy. Empty under --proxy, where the
        # page is generated and there is no file to name.
        if not data.get("source_file"):
            try:
                doc = urllib.parse.urlparse(data.get("url") or "").path or "/"
                data["document"] = doc
                if not self.proxy:
                    cand = Path(self.served_dir) / doc.lstrip("/")
                    if doc.endswith("/"):
                        cand = cand / "index.html"
                    if cand.is_file():
                        data["source_file"] = str(cand.resolve())
            except Exception:
                pass
        path.write_text(json.dumps(data, indent=2))
        sys.stderr.write(f"  annotation → {path.name}: {data.get('comment','')[:70]}\n")

        # Saving always works. Sending additionally wakes the agent now, so the
        # comment does not sit unread until something else happens to run.
        delivered, why, agent = False, "", None
        queued = 0
        if data.get("send"):
            delivered, why, agent = _deliver(self.served_dir, self.outdir, 1,
                                             [path.name], self.on_send)
            if delivered is None:
                queued = _queue_add([path.name])
                delivered = False
            sys.stderr.write(f"  send → {'delivered' if delivered else 'NOT delivered: ' + why}\n")
            agent = agent or self.target_name

        raw = json.dumps({"ok": True, "delivered": delivered, "queued": queued,
                          "why": why, "agent": agent}).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self._cors()
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def end_headers(self):
        self.send_header("Cache-Control", "no-store")
        super().end_headers()

    def _proxy_get(self):
        """Forward to a running dev server and inject into its HTML.

        This is what makes the overlay usable on a real application rather than a
        folder of files: point it at `npm run dev` and annotate the running app.
        Identity encoding is requested so there is no gzip to undo before the
        injection, which matters more than the bandwidth on localhost."""
        import urllib.error
        import urllib.request

        url = self.proxy.rstrip("/") + self.path
        req = urllib.request.Request(url, method="GET")
        for h in ("Accept", "Accept-Language", "User-Agent", "Cookie", "Referer"):
            if h in self.headers:
                req.add_header(h, self.headers[h])
        req.add_header("Accept-Encoding", "identity")
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                body = r.read()
                ctype = r.headers.get("Content-Type", "")
                status = r.status
                headers = [(k, v) for k, v in r.headers.items()
                           if k.lower() not in ("content-length", "content-encoding", "transfer-encoding")]
        except urllib.error.HTTPError as e:
            body, ctype, status = e.read(), e.headers.get("Content-Type", ""), e.code
            headers = []
        except Exception as e:
            self.send_error(502, f"proxy to {self.proxy} failed: {e}")
            return

        if "text/html" in ctype.lower():
            inject = OVERLAY.encode()
            body = body.replace(b"</body>", inject + b"</body>", 1) if b"</body>" in body else body + inject

        self.send_response(status)
        for k, v in headers:
            self.send_header(k, v)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_HEAD(self):
        # Virtual routes have no file on disk, so the inherited handler 404s and
        # then crashes logging it. Answer them here; everything else as normal.
        if self.path.startswith("/__annotate"):
            self.send_response(200)
            self.send_header("Content-Type", "application/javascript; charset=utf-8")
            self._cors()
            self.end_headers()
            return
        super().do_HEAD()

    def _cors(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.send_header("Access-Control-Allow-Methods", "POST, OPTIONS")

    def do_OPTIONS(self):
        # Preflight for the bookmarklet posting from another origin.
        self.send_response(204)
        self._cors()
        self.end_headers()

    def do_GET(self):
        if self.path.startswith("/__annotate?action=mine"):
            # Everything stamped for one agent, open first. What a session
            # checks when it wants its own work rather than the whole folder.
            who = urllib.parse.parse_qs(
                urllib.parse.urlparse(self.path).query).get("agent", [""])[0]
            pending, done = self._annotations()
            pick = lambda rows: [a for a in rows if not who or a.get("agent") == who]
            return self._json({"agent": who or self.target_name,
                               "pending": pick(pending), "done": pick(done)})
        if self.path.startswith("/__annotate?action=list"):
            pending, done = self._annotations()
            mine = SRC_MTIME
            latest = mine
            for cand in (shutil.which("annotate"),
                         str(Path.home() / ".local/bin/annotate")):
                try:
                    if cand and os.path.exists(cand):
                        latest = max(latest, os.path.getmtime(os.path.realpath(cand)))
                except OSError:
                    pass
            return self._json({
                # A long-lived server pins whatever code existed when it
                # started. A stale one looks identical to a current one, which
                # is exactly the kind of silent wrong answer worth surfacing.
                "version": VERSION,
                "started": STARTED,
                "stale": latest > mine + 1,
                "version_age_s": int(latest - mine),
                "pending": pending, "done": done,
                # Always say who these reach, so it is never a guess.
                "agent": self.target_name,
                "session": self.target_name,
            })
        if self.path.startswith("/__annotate.js"):
            # The overlay on its own, for a bookmarklet on a page we do not serve.
            js = OVERLAY.replace("<script>", "", 1).rsplit("</script>", 1)[0].encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/javascript; charset=utf-8")
            self._cors()
            self.send_header("Content-Length", str(len(js)))
            self.end_headers()
            self.wfile.write(js)
            return
        if self.proxy:
            self._proxy_get()
            return
        # Inject the overlay into HTML responses so the served pages need no edit.
        path = self.translate_path(self.path)
        if os.path.isdir(path):
            for idx in ("index.html", "index.htm"):
                if os.path.exists(os.path.join(path, idx)):
                    path = os.path.join(path, idx)
                    break
        if path.endswith((".html", ".htm")) and os.path.exists(path):
            body = Path(path).read_bytes()
            inject = OVERLAY.encode()
            if b"</body>" in body:
                body = body.replace(b"</body>", inject + b"</body>", 1)
            else:
                body += inject
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        super().do_GET()


# Comments queued because the agent was busy. Sending three in a row used to
# fail on the second: the first wakes the session, which is then busy, so the
# next is refused. They should accumulate and arrive together instead.
_QUEUE = set()
_QUEUE_LOCK = __import__("threading").Lock()


def _queue_add(files):
    with _QUEUE_LOCK:
        _QUEUE.update(files or [])
        return len(_QUEUE)


def _queue_take():
    with _QUEUE_LOCK:
        got, _QUEUE_ = sorted(_QUEUE), None
        return got


def _queue_clear(files):
    with _QUEUE_LOCK:
        _QUEUE.difference_update(files or [])
        return len(_QUEUE)


def _deliver(served_dir, outdir, n, files=None, hook=None):
    """Hand the comments to whoever should act on them.

    Delivery is a HOOK, not built in, because who to wake is entirely local:
    a tmux session, a webhook, an issue tracker, a desktop notification. The
    tool's job is to collect the comment and hand it over.

    The hook is run with the annotations directory as argv[1] and the chosen
    filenames after it, plus REDPEN_DIR and REDPEN_SERVED in the environment.
    Exit 0 means delivered. Anything it prints on the last line is shown to
    the commenter, so it can name who it woke.

    Without a hook, comments are saved and nothing else happens, which is a
    perfectly good mode: the agent reads .annotations/ when it next looks.
    """
    import subprocess as _sp
    if not hook:
        return False, "no --on-send hook configured", None
    cmd = [hook, str(outdir)] + list(files or [])
    env = dict(os.environ, REDPEN_DIR=str(outdir), REDPEN_SERVED=str(served_dir),
               REDPEN_COUNT=str(n))
    try:
        r = _sp.run(cmd, capture_output=True, text=True, timeout=60, env=env)
    except Exception as e:
        return False, str(e), None
    last = (r.stdout.strip().splitlines() or [""])[-1].strip()
    if r.returncode == 0:
        return True, "", (last or None)
    why = r.stderr.strip() or last or f"hook exited {r.returncode}"
    # 75 is EX_TEMPFAIL: the agent is busy or someone is typing. Not an error
    # to show him, just not now.
    if r.returncode == 75:
        return None, why, None
    return False, why, None


VERSION = "0.1.0"

STARTED = time.time()
# Snapshot at import. Comparing the running file's CURRENT mtime against the
# installed binary's current mtime compares a file to itself and can never
# fire, which is what the first version did.
SRC_MTIME = os.path.getmtime(__file__)


def tailnet_ip():
    """This machine's tailnet address, read off the interface.

    Not from the Tailscale CLI: under a stripped environment that exits 0 and
    prints "The Tailscale GUI failed to start" to stdout, so the failure
    arrives looking exactly like an answer.
    """
    import re as _re, subprocess as _sp
    try:
        out = _sp.run(["/sbin/ifconfig"], capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return None
    for m in _re.finditer(r"inet (100\.\d{1,3}\.\d{1,3}\.\d{1,3})", out):
        ip = m.group(1)
        if 64 <= int(ip.split(".")[1]) <= 127:   # Tailscale's CGNAT range
            return ip
    return None


def _drain_queue(served_dir, outdir, hook, target):
    """Deliver what is waiting, once the agent is free.

    Processing three comments in a row used to fail on the second: the first
    wakes the session, which is then busy, so the next was refused with an
    error. They queue instead, and everything waiting goes in ONE message, so
    three comments read as three comments rather than waking the session three
    times.
    """
    import threading
    import time as _t

    def loop():
        while True:
            _t.sleep(12)
            files = _queue_take()
            if not files:
                continue
            # Only send what still exists: anything already actioned has moved
            # to done/ and must not be delivered a second time.
            alive = [f for f in files if (Path(outdir) / f).is_file()]
            gone = [f for f in files if f not in alive]
            if gone:
                _queue_clear(gone)
            if not alive:
                continue
            ok, why, _who = _deliver(served_dir, outdir, len(alive), alive, hook)
            if ok:
                _queue_clear(alive)
                sys.stderr.write(f"  queued → delivered {len(alive)} to {target or 'the agent'}\n")
            elif ok is False:
                _queue_clear(alive)          # permanent failure: stop retrying
                sys.stderr.write(f"  queued → gave up: {why}\n")

    threading.Thread(target=loop, daemon=True).start()


def main():
    ap = argparse.ArgumentParser(description="Serve a directory with an annotation overlay.")
    ap.add_argument("directory", nargs="?", default=".",
                    help="directory to serve (ignored with --proxy, which still uses it for --out)")
    ap.add_argument("--proxy", default=None, metavar="URL",
                    help="annotate a running app instead of files, e.g. http://localhost:3000")
    ap.add_argument("--port", type=int, default=8765)
    ap.add_argument("--bind", default=None, metavar="ADDR",
                    help="address to bind (default: 127.0.0.1; use --tailnet "
                         "to let the laptop reach it directly via `show`)")
    ap.add_argument("--tailnet", action="store_true",
                    help="(default) bind the tailnet address, so `show <port>` works")
    ap.add_argument("--local", action="store_true",
                    help="bind 127.0.0.1 instead: nothing on the tailnet can reach it")
    ap.add_argument("--bookmarklet", action="store_true",
                    help="also print a bookmarklet for annotating pages this server does not serve")
    ap.add_argument("--out", default=None, help="where annotations land (default: <dir>/.annotations)")
    ap.add_argument("--on-send", default=None, metavar="CMD",
                    help="run CMD when he presses process (default: "
                         "~/.local/bin/redpen-deliver if present), with the annotations dir "
                         "and chosen filenames as arguments. Exit 0 = delivered; "
                         "its last line of stdout names who was reached.")
    ap.add_argument("--no-send", action="store_true",
                    help="collect comments only; do not wake anyone")
    ap.add_argument("--version", action="version", version=f"redpen {VERSION}")
    ap.add_argument("--to", default=None, metavar="NAME",
                    help="who comments reach, shown in the drawer")
    a = ap.parse_args()

    root = Path(a.directory).expanduser().resolve()
    if not root.is_dir():
        sys.exit(f"not a directory: {root}")
    outdir = Path(a.out).expanduser().resolve() if a.out else root / ".annotations"

    Handler.root = root
    Handler.outdir = outdir
    Handler.served_dir = str(Path(a.directory).resolve())
    # Default the hook when one is installed. Without this, an agent that
    # forgets the flag serves a page where "process" quietly reaches nobody,
    # and the only clue is the drawer saying so in small red text.
    default_hook = str(Path.home() / ".local/bin/redpen-deliver")
    Handler.on_send = None if a.no_send else (
        a.on_send or (default_hook if os.path.exists(default_hook) else None))
    # If a hook is configured but nobody said who it reaches, ask it once:
    # run with REDPEN_PROBE=1 and no files. By convention it prints the name
    # and delivers nothing. Beats polling it on every drawer refresh, and beats
    # making the commenter guess from the folder name.
    Handler.target_name = a.to
    if Handler.on_send and not a.to:
        try:
            import subprocess as _sp
            r = _sp.run([Handler.on_send, str(outdir)], capture_output=True, text=True,
                        timeout=20, env=dict(os.environ, REDPEN_PROBE="1",
                                             REDPEN_SERVED=Handler.served_dir))
            if r.returncode == 0:
                Handler.target_name = (r.stdout.strip().splitlines() or [""])[-1].strip() or None
        except Exception:
            pass
    Handler.proxy = a.proxy
    os.chdir(root)

    # Threaded, not the plain TCPServer this used to be. A browser holds its
    # connection open (keep-alive), and a single-threaded server then blocks
    # every later request behind it: the page loads once and the server appears
    # dead to everything afterwards, including the annotation POSTs and any
    # second tab. It reports HTTP 000 on its own localhost while still listening,
    # which reads like a network problem and is not one.
    #
    # daemon_threads so ctrl-c does not hang waiting on an idle keep-alive.
    class Server(socketserver.ThreadingTCPServer):
        allow_reuse_address = True
        daemon_threads = True

    bind = a.bind
    # Tailnet by default: the normal case is that he wants to look at it, and
    # that needs his laptop to reach this machine. --local for anything that
    # should not be reachable from every device on the tailnet.
    if not bind and not a.local:
        a.tailnet = True
    if a.tailnet and not a.local:
        bind = tailnet_ip()
        if not bind:
            say("  no tailnet address found; is Tailscale up?")
            sys.exit(2)
    bind = bind or "127.0.0.1"

    with Server((bind, a.port), Handler) as httpd:
        say = lambda m="": print(m, flush=True)
        say(f"  proxying {a.proxy}" if a.proxy else f"  serving {root}")
        say(f"  annotations → {outdir}")
        if bind == "127.0.0.1":
            say(f"  on 127.0.0.1:{a.port} (local only), from the laptop: peek {a.port}")
        else:
            say(f"  on {bind}:{a.port}, put it on his screen with: show {a.port}")
        say("  comments go to: " + (Handler.target_name or "nobody, no agent owns this folder")
            if Handler.on_send else "  comments are collected only, nobody will be woken")
        if Handler.on_send:
            _drain_queue(Handler.served_dir, outdir, Handler.on_send, Handler.target_name)
        say("  select text + A, option-click (\u2325) anything, or shift-drag a box. ctrl-c to stop.")
        if a.bookmarklet:
            # For a page this server does not serve. Works where the site's CSP
            # allows an injected script; strict script-src (GitHub, most banks)
            # will refuse it, and nothing here can change that.
            say()
            say("  bookmarklet — save as a browser bookmark, click it on any page:")
            say()
            say(f"    javascript:(function(){{var s=document.createElement('script');"
                  f"s.src='http://localhost:{a.port}/__annotate.js?'+Date.now();"
                  f"document.body.appendChild(s);}})();")
            say()
            say(f"  it posts back to localhost:{a.port}, so keep `peek {a.port}` open.")
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            say("\n  stopped")


if __name__ == "__main__":
    main()
